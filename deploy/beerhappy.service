[Unit]
Description=Beerhappy secret beer exchange
After=network.target

[Service]
User=beerhappy
Group=beerhappy
WorkingDirectory=/opt/beerhappy
EnvironmentFile=/etc/beerhappy.env
ExecStart=/usr/bin/python3 /opt/beerhappy/server.py
Restart=on-failure
RestartSec=3
StateDirectory=beerhappy
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/beerhappy

[Install]
WantedBy=multi-user.target
